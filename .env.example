# Database
DATABASE_URL="postgresql://slvp:slvp_dev@localhost:5432/slvp_dev"

# Application
APP_URL="http://localhost:3000"

# Auth
AUTH_SECRET="change-me-to-a-random-secret-at-least-32-chars"
# Local testing only. Set to "true" to bypass /admin and /partner login gates.
DISABLE_PORTAL_AUTH="false"
# Optional demo identities used when DISABLE_PORTAL_AUTH="true".
DISABLE_PORTAL_AUTH_ADMIN_USER_ID="local-demo-admin"
DISABLE_PORTAL_AUTH_PARTNER_USER_ID="local-demo-partner-user"
DISABLE_PORTAL_AUTH_PARTNER_ID="local-demo-partner"

# Seed admin
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="Admin User"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# Legal
AGREEMENT_PACKET_URL=""
